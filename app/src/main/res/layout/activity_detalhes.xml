<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070812">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- CAPA -->
        <ImageView
            android:id="@+id/imgJogo"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:contentDescription="Imagem do jogo"
            android:scaleType="centerCrop" />

        <!-- CONTEÚDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CLASSIFICAÇÃO -->
            <TextView
                android:id="@+id/txtClassificacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classificação: Livre"
                android:textColor="#A855F7"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- NOME -->
            <TextView
                android:id="@+id/txtNomeJogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nome do jogo"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- DATA DE LANÇAMENTO -->
            <TextView
                android:id="@+id/txtDataLancamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lançamento: --"
                android:textColor="#888DA0"
                android:textSize="13sp" />

            <!-- DESCRIÇÃO -->
            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp"
                android:text="Descrição do jogo"
                android:textColor="#B7BAC7"
                android:textSize="14sp" />

            <!-- PREÇO -->
            <TextView
                android:id="@+id/txtPreco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="R$ 0,00"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- DISPONIBILIDADE -->
            <TextView
                android:id="@+id/txtPlataforma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Disponível no catálogo"
                android:textColor="#888DA0"
                android:textSize="13sp" />

            <!-- BOTÃO CARRINHO -->
            <Button
                android:id="@+id/btnAdicionarCarrinho"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#6C2BD9"
                android:text="ADICIONAR AO CARRINHO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- FAVORITO -->
            <Button
                android:id="@+id/btnFavorito"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#191C2A"
                android:text="♡  ADICIONAR AOS FAVORITOS"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
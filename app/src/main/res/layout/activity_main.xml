<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B16">

    <!-- CONTEÚDO PRINCIPAL -->
    <LinearLayout
        android:id="@+id/conteudoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#080B16">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnMenuTopo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Menu"
                android:padding="9dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOADING"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAMES"
                    android:textColor="#A855F7"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFavoritosTopo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Favoritos"
                android:padding="9dp"
                android:src="@drawable/ic_favorite" />

            <ImageButton
                android:id="@+id/btnCarrinhoTopo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Carrinho"
                android:padding="9dp"
                android:src="@drawable/ic_cart" />

            <ImageButton
                android:id="@+id/btnPerfilTopo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Perfil"
                android:padding="9dp"
                android:src="@drawable/ic_person" />
        </LinearLayout>

        <!-- ROLAGEM DA HOME -->
        <ScrollView
            android:id="@+id/scrollHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp">

                <!-- PESQUISA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="18dp"
                    android:background="#111421"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Pesquisar"
                        android:src="@drawable/ic_search"
                        app:tint="#858999" />

                    <EditText
                        android:id="@+id/edtPesquisa"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Buscar jogos..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#858999"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- BANNER -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="255dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="18dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Resident Evil 4"
                        android:scaleType="centerCrop"
                        android:src="@drawable/resident_evil" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#88000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#6C2BD9"
                            android:padding="6dp"
                            android:text="DESTAQUE"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="RESIDENT EVIL 4"
                            android:textColor="#FFFFFF"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sobreviva ao terror. Enfrente o inimigo. Reviva o clássico."
                            android:textColor="#D6D6DC"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="R$ 199,90"
                                android:textColor="#C084FC"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnComprar"
                                android:layout_width="150dp"
                                android:layout_height="43dp"
                                android:backgroundTint="#7C3AED"
                                android:text="COMPRAR AGORA"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- INDICADORES DO BANNER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="4dp"
                        android:background="#A855F7" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="6dp"
                        android:background="#454858" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="6dp"
                        android:background="#454858" />
                </LinearLayout>

                <!-- TÍTULO DOS JOGOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:id="@+id/txtTituloJogos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Explore nossos jogos"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVerTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:text="Ver todos  ›"
                        android:textColor="#A855F7"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- JOGOS EM DUAS COLUNAS -->
                <LinearLayout
                    android:id="@+id/containerJogos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="20dp" />

            </LinearLayout>
        </ScrollView>

        <!-- ====================================== -->
        <!-- MENU DE NAVEGAÇÃO INFERIOR -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#111421"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- INÍCIO -->
            <LinearLayout
                android:id="@+id/btnInicioMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="Início"
                    android:src="@drawable/ic_home"
                    app:tint="#A855F7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Início"
                    android:textColor="#A855F7"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- BUSCAR -->
            <LinearLayout
                android:id="@+id/btnBuscarMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="#9295A5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Buscar"
                    android:textColor="#9295A5"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- CATEGORIAS -->
            <LinearLayout
                android:id="@+id/btnCategoriasMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="Categorias"
                    android:src="@drawable/ic_categories"
                    app:tint="#9295A5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Categorias"
                    android:textColor="#9295A5"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- FAVORITOS -->
            <LinearLayout
                android:id="@+id/btnFavoritosMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="Favoritos"
                    android:src="@drawable/ic_favorite"
                    app:tint="#9295A5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Favoritos"
                    android:textColor="#9295A5"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- CARRINHO -->
            <LinearLayout
                android:id="@+id/btnCarrinhoMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="Carrinho"
                    android:src="@drawable/ic_cart"
                    app:tint="#9295A5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Carrinho"
                    android:textColor="#9295A5"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    <!-- FIM DO CONTEÚDO PRINCIPAL -->

    <!-- ====================================== -->
    <!-- FUNDO ESCURO DO MENU LATERAL -->
    <!-- ====================================== -->

    <View
        android:id="@+id/fundoMenuLateral"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- ====================================== -->
    <!-- MENU LATERAL -->
    <!-- ====================================== -->

    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111421"
        android:elevation="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- CABEÇALHO DO MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LOADING GAMES"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFecharMenu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- DIVISÓRIA -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#292D43" />

        <!-- CONTEÚDO ROLÁVEL DO MENU -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- DADOS DO USUÁRIO -->
                <LinearLayout
                    android:id="@+id/cabecalhoUsuarioLateral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <!-- AVATAR -->
                    <ImageView
                        android:id="@+id/imgAvatarLateral"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_avatar"
                        android:contentDescription="Avatar do usuário"
                        android:padding="12dp"
                        android:src="@drawable/ic_person" />

                    <!-- NOME E EMAIL -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomeUsuarioLateral"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Olá, jogador!"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtEmailUsuarioLateral"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="Entre para acessar sua conta"
                            android:textColor="#9295A5"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnContaCabecalhoLateral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="ENTRAR  ›"
                            android:textColor="#C084FC"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>

                <!-- DIVISÓRIA -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="#292D43" />

                <!-- ================================= -->
                <!-- OPÇÕES PARA USUÁRIO LOGADO -->
                <!-- ================================= -->

                <LinearLayout
                    android:id="@+id/menuUsuarioLogado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="22dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:text="MINHA CONTA"
                        android:textColor="#A855F7"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- MINHA CONTA -->
                    <LinearLayout
                        android:id="@+id/btnMinhaContaLateral"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="Minha conta"
                            android:src="@drawable/ic_person"
                            app:tint="#C084FC" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="17dp"
                            android:layout_weight="1"
                            android:text="Minha conta"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#9295A5"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- MINHA BIBLIOTECA -->
                    <LinearLayout
                        android:id="@+id/btnBibliotecaLateral"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="Minha biblioteca"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="#C084FC" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="17dp"
                            android:layout_weight="1"
                            android:text="Minha biblioteca"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#9295A5"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- MINHAS COMPRAS -->
                    <LinearLayout
                        android:id="@+id/btnComprasLateral"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="Minhas compras"
                            android:src="@drawable/ic_cart"
                            app:tint="#C084FC" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="17dp"
                            android:layout_weight="1"
                            android:text="Minhas compras"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#9295A5"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- CONFIGURAÇÕES -->
                    <LinearLayout
                        android:id="@+id/btnConfiguracoesLateral"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="Configurações"
                            android:src="@drawable/ic_settings"
                            app:tint="#C084FC" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="17dp"
                            android:layout_weight="1"
                            android:text="Configurações"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#9295A5"
                            android:textSize="24sp" />
                    </LinearLayout>

                </LinearLayout>
                <!-- FIM DO MENU DO USUÁRIO LOGADO -->

                <!-- ================================= -->
                <!-- OPÇÕES PARA USUÁRIO VISITANTE -->
                <!-- ================================= -->

                <LinearLayout
                    android:id="@+id/menuUsuarioVisitante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="22dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:text="ACESSAR CONTA"
                        android:textColor="#A855F7"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- ENTRAR -->
                    <LinearLayout
                        android:id="@+id/btnEntrarLateral"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="Entrar"
                            android:src="@drawable/ic_person"
                            app:tint="#C084FC" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="17dp"
                            android:layout_weight="1"
                            android:text="Entrar"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#9295A5"
                            android:textSize="24sp" />

                    </LinearLayout>

                    <!-- CRIAR CONTA -->
                    <LinearLayout
                        android:id="@+id/btnCriarContaLateral"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="Criar conta"
                            android:src="@drawable/ic_person"
                            app:tint="#C084FC" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="17dp"
                            android:layout_weight="1"
                            android:text="Criar conta"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#9295A5"
                            android:textSize="24sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ================================= -->
                <!-- DIVISÓRIA -->
                <!-- ================================= -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="10dp"
                    android:background="#292D43" />

                <!-- ================================= -->
                <!-- AJUDA E SUPORTE -->
                <!-- ================================= -->

                <LinearLayout
                    android:id="@+id/btnAjudaLateral"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="#C084FC"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:layout_weight="1"
                        android:text="Ajuda e suporte"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#9295A5"
                        android:textSize="24sp" />

                </LinearLayout>

                <!-- ================================= -->
                <!-- SAIR DA CONTA -->
                <!-- ================================= -->

                <LinearLayout
                    android:id="@+id/btnSairLateral"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:gravity="center"
                        android:text="↪"
                        android:textColor="#F87171"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:layout_weight="1"
                        android:text="Sair da conta"
                        android:textColor="#F87171"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#9295A5"
                        android:textSize="24sp" />

                </LinearLayout>

                <!-- ESPAÇAMENTO FINAL -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />

            </LinearLayout>
            <!-- FIM DO CONTEÚDO ROLÁVEL -->

        </ScrollView>

    </LinearLayout>
    <!-- FIM DO MENU LATERAL -->

</FrameLayout>
    <!-- FIM DO ACTIVITY_MAIN.XML -->

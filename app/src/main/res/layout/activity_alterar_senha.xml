<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#080912">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALTERAR SENHA"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mantenha sua conta protegida"
            android:textColor="#9696AA"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="🔒"
            android:textSize="44sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_perfil">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SENHA ATUAL"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtSenhaAtual"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Digite sua senha atual"
                android:inputType="textPassword"
                android:drawableEnd="@android:drawable/ic_menu_view"
                android:drawableTint="#CB78FF"
                android:textColor="#FFFFFF"
                android:textColorHint="#85859A"
                android:backgroundTint="#4C3567"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="NOVA SENHA"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtNovaSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Digite a nova senha"
                android:inputType="textPassword"
                android:drawableEnd="@android:drawable/ic_menu_view"
                android:drawableTint="#CB78FF"
                android:textColor="#FFFFFF"
                android:textColorHint="#85859A"
                android:backgroundTint="#4C3567"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="CONFIRMAR NOVA SENHA"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtConfirmarSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Confirme a nova senha"
                android:inputType="textPassword"
                android:drawableEnd="@android:drawable/ic_menu_view"
                android:drawableTint="#CB78FF"
                android:textColor="#FFFFFF"
                android:textColorHint="#85859A"
                android:backgroundTint="#4C3567"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnAlterarSenhaSalvar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="ATUALIZAR SENHA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8000FF"/>

    </LinearLayout>
</ScrollView>

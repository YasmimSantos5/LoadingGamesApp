<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080912">

    <!-- ====================================== -->
    <!-- CABEÇALHO -->
    <!-- ====================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/btnVoltarBiblioteca"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:contentDescription="Voltar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINHA BIBLIOTECA"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Seus jogos em um só lugar"
                android:textColor="#9696AA"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Biblioteca"
            android:src="@drawable/ic_categories"
            app:tint="#A855F7" />

    </LinearLayout>

    <!-- DIVISOR -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#202330" />

    <!-- ====================================== -->
    <!-- CONTEÚDO DA BIBLIOTECA -->
    <!-- ====================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp">

        <!-- TÍTULO DA SEÇÃO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meus jogos"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- TOTAL DE JOGOS -->

        <TextView
            android:id="@+id/txtTotalJogosBiblioteca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Carregando seus jogos..."
            android:textColor="#9696AA"
            android:textSize="13sp" />

        <!-- LINHA DE DESTAQUE -->

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="15dp"
            android:background="#A855F7" />

        <!-- ================================== -->
        <!-- INDICADOR DE CARREGAMENTO -->
        <!-- ================================== -->

        <ProgressBar
            android:id="@+id/progressoBiblioteca"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="35dp"
            android:indeterminateTint="#A855F7" />

        <!-- ================================== -->
        <!-- BIBLIOTECA VAZIA -->
        <!-- ================================== -->

        <TextView
            android:id="@+id/txtBibliotecaVazia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:padding="18dp"
            android:text="🎮&#10;&#10;Sua biblioteca está vazia&#10;&#10;Os jogos que você comprar aparecerão aqui."
            android:textColor="#9696AA"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- ================================== -->
        <!-- LISTA DE JOGOS COMPRADOS -->
        <!-- ================================== -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerJogosBiblioteca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />

        </ScrollView>

    </LinearLayout>

    <!-- ========================================== -->
    <!-- MENU INFERIOR - PADRÃO DA MAIN -->
    <!-- ========================================== -->

    <LinearLayout
        android:id="@+id/menuInferiorBiblioteca"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0D0F1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:elevation="12dp">

        <!-- ====================================== -->
        <!-- INÍCIO -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/btnInicioBiblioteca"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Início"
                android:src="@drawable/ic_home"
                app:tint="#777B8A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Início"
                android:textColor="#777B8A"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ====================================== -->
        <!-- BUSCAR -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/btnBuscarBiblioteca"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search"
                app:tint="#777B8A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Buscar"
                android:textColor="#777B8A"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ====================================== -->
        <!-- CATEGORIAS -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/btnCategoriasBiblioteca"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Categorias"
                android:src="@drawable/ic_categories"
                app:tint="#777B8A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Categorias"
                android:textColor="#777B8A"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ====================================== -->
        <!-- FAVORITOS -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/btnFavoritosBiblioteca"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Favoritos"
                android:src="@drawable/ic_favorite"
                app:tint="#777B8A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Favoritos"
                android:textColor="#777B8A"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ====================================== -->
        <!-- CARRINHO -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/btnCarrinhoBiblioteca"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Carrinho"
                android:src="@drawable/ic_cart"
                app:tint="#777B8A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Carrinho"
                android:textColor="#777B8A"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

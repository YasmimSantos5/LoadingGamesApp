<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#080912">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MEUS DADOS"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informações da sua conta"
            android:textColor="#9696AA"
            android:textSize="14sp"
            android:layout_marginBottom="26dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card_perfil">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOME COMPLETO"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtNomeDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#4C3567"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="NOME DE USUÁRIO"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtUsuarioDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#4C3567"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="E-MAIL"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtEmailDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#4C3567"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="TIPO DE CONTA"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🎮 Usuário Comum"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="DATA DE CADASTRO"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtDataCadastroDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Não disponível"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="SENHA ATUAL"
                android:textColor="#CB78FF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtSenhaAtualDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Digite sua senha para confirmar"
                android:textColorHint="#9696AA"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#4C3567"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnSalvarDados"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="EDITAR DADOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8000FF"/>

    </LinearLayout>
</ScrollView>

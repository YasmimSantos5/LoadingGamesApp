<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#080912">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONFIGURAÇÕES DA CONTA"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:text="Personalize sua experiência"
            android:textColor="#9696AA"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card_perfil">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔔  Notificações"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Switch
                    android:id="@+id/switchNotificacoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#CB78FF"
                    android:trackTint="#52376C"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#29243B"/>

            <TextView
                android:id="@+id/btnPrivacidadeConta"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:text="🔒  Privacidade                         ›"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#29243B"/>

            <TextView
                android:id="@+id/btnIdiomaConta"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:text="🌐  Idioma                                ›"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#29243B"/>

            <TextView
                android:id="@+id/btnTemaConta"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:text="🎨  Tema                                  ›"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ZONA DE PERIGO"
            android:textColor="#FF6B80"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnExcluirConta"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:padding="18dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_perfil"
            android:text="🗑  Excluir conta"
            android:textColor="#FF6B80"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnSairConfiguracoes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:text="SAIR DA CONTA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#30104C"/>

    </LinearLayout>
</ScrollView>
